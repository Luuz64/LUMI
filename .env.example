# Never put secrets in VITE_* variables: those are public browser values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Enable only for an intentional operator test. This switch is not school approval.
LUMI_AI_ENABLED=false
# Exakte Produktions-Adresse ohne Pfad oder Schrägstrich am Ende.
LUMI_APP_ORIGIN=https://lumi-rust-ten.vercel.app

# Public build-time flag for a standalone design preview without any AI requests.
VITE_LOCAL_PREVIEW=false

# Server-only. MINDESTENS 16 Zeichen (max. 128), sonst meldet die App
# "Der Testzugang ist noch nicht eingerichtet". Lieber 20+ Zeichen wählen.
# Never use a VITE_ prefix.
LUMI_PILOT_CODE=
