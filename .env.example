# Never put secrets in VITE_* variables: those are public browser values.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Enable only for an intentional operator test. This switch is not school approval.
LUMI_AI_ENABLED=false
LUMI_APP_ORIGIN=https://lumi-git-feat-lumi-learning-pilot-luuz.vercel.app

# Public build-time flag for a standalone design preview without any AI requests.
VITE_LOCAL_PREVIEW=false

# Server-only. Random, 16–128 characters. Never use a VITE_ prefix.
LUMI_PILOT_CODE=
